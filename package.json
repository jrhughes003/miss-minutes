{
  "name": "miss-minutes",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first to-dos, reliable reminders and Google Calendar in one desktop app, with optional Claude-powered capture and planning.",
  "author": "jrhughes003",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "preview": "vite preview",
    "electron:dev": "node scripts/build-electron.mjs && concurrently -k -n vite,main,app \"vite\" \"node scripts/build-electron.mjs --watch\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 MISS_MINUTES_USER_DATA=.dev-user-data node scripts/run-electron.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:electron": "npm run build && node scripts/build-electron.mjs && playwright test -c playwright.electron.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "npm run build && node scripts/build-electron.mjs && cross-env ELECTRON_BUILDER_CACHE=node_modules/.cache/electron-builder electron-builder --win --publish never",
    "electron": "npm run build && node scripts/build-electron.mjs && node scripts/run-electron.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.missminutes.app",
    "productName": "Miss Minutes",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/tray@2x.png",
        "to": "tray@2x.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Miss Minutes"
    }
  }
}
