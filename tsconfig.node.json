{
  // Electron main + preload, build scripts, configs and end-to-end specs.
  // No DOM lib: `window` or `document` in the main process is a type error.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "electron/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    // DOM-free helpers shared with the Electron tests.
    "src/storage/localRepo.ts",
    "src/storage/localReminderLog.ts",
    "src/demo/fakeCalendar.ts",
    "src/test/repoContract.ts",
    "src/test/reminderLogContract.ts",
    "e2e/**/*.ts",
    "e2e-electron/**/*.ts",
    "e2e-demo/**/*.ts",
    "playwright.demo.config.ts",
    "playwright.electron.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["src/**/*.tsx"]
}
